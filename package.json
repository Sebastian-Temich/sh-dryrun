{
  "name": "sh-dryrun",
  "version": "0.1.0",
  "description": "Funkcje pomocnicze w TypeScript: slug, format kwoty, dzielenie tablic, ponawianie, kurs NBP, przeliczenie.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "build": "tsup"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
